      "type": "formula",
      "description": "True profit margin based on the price you'll actually quote",
      "options": {
        "expression": "IF(IF({fldxoD9TSRD0qyC03m0}, {fldxoD9TSRD0qyC03m0}, IF(AND({fldSkeBjzSPgNcBdz72}, {fldHEz4AVaJ76nEeYTx}), ROUND({fldSkeBjzSPgNcBdz72} / (1 - {fldHEz4AVaJ76nEeYTx} / 100), 2), 0)) > 0, ROUND((IF({fldxoD9TSRD0qyC03m0}, {fldxoD9TSRD0qyC03m0}, IF(AND({fldSkeBjzSPgNcBdz72}, {fldHEz4AVaJ76nEeYTx}), ROUND({fldSkeBjzSPgNcBdz72} / (1 - {fldHEz4AVaJ76nEeYTx} / 100), 2), 0)) - {fldSkeBjzSPgNcBdz72}) / IF({fldxoD9TSRD0qyC03m0}, {fldxoD9TSRD0qyC03m0}, IF(AND({fldSkeBjzSPgNcBdz72}, {fldHEz4AVaJ76nEeYTx}), ROUND({fldSkeBjzSPgNcBdz72} / (1 - {fldHEz4AVaJ76nEeYTx} / 100), 2), 0)) * 100, 1), 0)",
        "timeZone": "America/Chicago",
        "formatting": {
          "type": "decimal",
          "precision": 2
        }
