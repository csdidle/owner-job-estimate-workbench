      "id": "flduRKNObQ4sCaHvd0U",
      "name": "Total Depreciation to Date",
      "dbFieldName": "Total_Depreciation_to_Date",
      "type": "formula",
      "description": "Cumulative depreciation taken since purchase using MACRS 7-year rates. Yr1: 14.29%, Yr1-2: 38.78%, Yr1-3: 56.27%, Yr1-4: 68.76%, Yr1-5: 77.69%, Yr1-6: 86.61%, Yr1-7: 95.54%, Yr1-8: 100%\"",
      "options": {
        "expression": "IF(AND({fldIRtG6cZ4VmxieAYx}, {fldLU053S12uoQCCNyh}), ROUND({fldIRtG6cZ4VmxieAYx} * SWITCH(MIN(CEILING(DATETIME_DIFF(TODAY(), {fldLU053S12uoQCCNyh}, 'day') / 365, 1), 9), 1, 0.1429, 2, 0.3878, 3, 0.5627, 4, 0.6876, 5, 0.7769, 6, 0.8661, 7, 0.9554, 8, 1.0, 9, 1.0, 0), 2), 0)",
