    {
      "id": "fldWOkbPE1OArgS9j5C",
      "name": "Daily Depreciation",
      "dbFieldName": "Depreciation",
      "type": "formula",
      "description": "IRS MACRS 7-year depreciation calculated daily. Rates: Yr1=14.29%, Yr2=24.49%, Yr3=17.49%, Yr4=12.49%, Yr5=8.93%, Yr6=8.92%, Yr7=8.93%, Yr8=4.46% (half-year convention). Shows $0 after fully depreciated.",
      "options": {
        "expression": "IF(AND({fldIRtG6cZ4VmxieAYx}, {fldLU053S12uoQCCNyh}), IF(CEILING(DATETIME_DIFF(TODAY(), {fldLU053S12uoQCCNyh}, 'day') / 365, 1) > 8, 0, ROUND({fldIRtG6cZ4VmxieAYx} * SWITCH(CEILING(DATETIME_DIFF(TODAY(), {fldLU053S12uoQCCNyh}, 'day') / 365, 1), 1, 0.1429, 2, 0.2449, 3, 0.1749, 4, 0.1249, 5, 0.0893, 6, 0.0892, 7, 0.0893, 8, 0.0446, 0) / 365, 2)), 0)",
